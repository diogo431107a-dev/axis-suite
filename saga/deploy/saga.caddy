# Saga's Caddy site. axis-suite/deploy/install.sh fills in the @PLACEHOLDERS@ and writes it
# to /etc/caddy/sites.d/saga.caddy.
@SITE@ {
	import axis_site

	# Saga has its own accounts and checks every request itself, so Caddy only forwards it.
	# Nothing else reaches the service: its /admin routes are for the owner's command line,
	# on the server itself.
	handle /api/* {
		reverse_proxy 127.0.0.1:@PORT@
	}

	# The built game. Unknown paths fall back to index.html.
	handle {
		root * @APP_DIR@/dist/web
		# The game sets colours with style="--c:…" attributes, so styles may be inline; scripts may not.
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Vite puts a content hash in every file name under /assets, so they never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
