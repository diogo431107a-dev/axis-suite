# Lets certbot keep renewing a certificate (e.g. for a mail server) while Caddy owns port 80.
# Copy to /etc/caddy/sites.d/, replace the domain, then switch certbot to webroot mode
# (see README, "Sharing the server with certbot").
http://mail.example.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}
	handle {
		respond 404
	}
}
