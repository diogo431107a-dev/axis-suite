[Unit]
Description=Heimdall, the Axis Suite sign-in service
After=network.target

[Service]
Type=simple
# A throwaway system user is created for each run; it can only write to its StateDirectory.
DynamicUser=yes
WorkingDirectory=/opt/heimdall
# Saved sessions live in /var/lib/heimdall (passed to the app as STATE_DIRECTORY).
StateDirectory=heimdall
StateDirectoryMode=0700
UMask=0077
# Written by axis-suite/deploy/install.sh: the suite's domain and URLs (incl. COOKIE_DOMAIN),
# then this module's HOST, PORT and PUBLIC_URL. Other modules add RETURN_ORIGIN_<MODULE>
# through drop-ins in /etc/systemd/system/heimdall.service.d/.
EnvironmentFile=/etc/axis-suite/suite.env
EnvironmentFile=/etc/axis-suite/heimdall.env
Environment=NODE_ENV=production
# Trust Caddy's X-Forwarded-For, and only send the cookie over HTTPS.
Environment=TRUST_PROXY=1
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/node /opt/heimdall/dist/server/index.js
Restart=on-failure
RestartSec=2

# Hardening. Keep this block the same in every module's unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
