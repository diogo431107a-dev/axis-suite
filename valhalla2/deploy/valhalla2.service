[Unit]
Description=Valhalla 2, the Axis Suite companions API
After=network.target heimdall.service

[Service]
Type=simple
# A throwaway system user is created for each run; it can only write to its StateDirectory.
DynamicUser=yes
WorkingDirectory=/opt/valhalla2
# Everyone's companions, chats and memory live in /var/lib/valhalla2/valhalla2.db
# (the folder is passed to the app as STATE_DIRECTORY).
StateDirectory=valhalla2
StateDirectoryMode=0700
UMask=0077
# Written by axis-suite/deploy/install.sh: the suite's domain and Heimdall's URLs,
# then this module's HOST, PORT and PUBLIC_URL.
EnvironmentFile=/etc/axis-suite/suite.env
EnvironmentFile=/etc/axis-suite/valhalla2.env
Environment=NODE_ENV=production
# The models a new companion starts with; each companion can change both in its settings.
Environment=CHAT_MODEL=claude-haiku-5-5
Environment=MEMORY_MODEL=claude-sonnet-5-5
# The Claude API key, put there by hand before the first install (see Valhalla 2's README):
# one line, root-only. systemd hands a copy to the service as $CREDENTIALS_DIRECTORY/anthropic-api-key
# and refuses to start it while the file is missing.
# Deliberately not named valhalla2.key: for /etc/axis-suite/<module>.key the installer writes
# 32 random bytes, which would be no use as an API key.
LoadCredential=anthropic-api-key:/etc/axis-suite/valhalla2-anthropic.key
ExecStart=/usr/bin/node /opt/valhalla2/dist/server/index.js
Restart=on-failure
RestartSec=2

# Hardening. Keep this block the same in every module's unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
