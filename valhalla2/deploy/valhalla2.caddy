# Valhalla 2's Caddy site. axis-suite/deploy/install.sh fills in the @PLACEHOLDERS@ and writes it
# to /etc/caddy/sites.d/valhalla2.caddy.
@SITE@ {
	import axis_site

	# The API checks every request with Heimdall itself, so Caddy only forwards it.
	# A reply streams in as server-sent events while Claude writes it; flush_interval -1 passes
	# each piece on at once instead of holding it in a buffer. The JSON routes don't mind.
	handle /api/* {
		reverse_proxy 127.0.0.1:@PORT@ {
			flush_interval -1
		}
	}

	# The built React app. Unknown paths fall back to index.html.
	handle {
		root * @APP_DIR@/dist/web
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Vite puts a content hash in every file name under /assets, so they never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
