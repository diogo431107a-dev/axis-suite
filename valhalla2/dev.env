# Settings for local development only (pnpm dev). On a server, deploy/install.sh sets these.
#
# This file is committed, and the repository is public: never put an API key here.
# They go in data/secret.env instead (ANTHROPIC_API_KEY=..., CIVITAI_API_KEY=..., XAI_API_KEY=...,
# OPENAI_API_KEY=..., SPEECH_KEY=...),
# which git ignores and the installer never copies. On a server they are files in /etc/axis-suite.
#
# The demo users in heimdall/server/users.ts. Keep in step.
AXIS_USERS=diro,prefsbs,odin,freya,john

# The models a new companion starts with: one answers in character, one keeps its memory.
# Each companion can change both in its settings.
CHAT_MODEL=claude-haiku-5-5
MEMORY_MODEL=claude-sonnet-5-5

# Reading aloud: the region of the Azure Speech resource SPEECH_KEY belongs to, and the voice for a
# companion that chooses none. Grok's voices (grok:eve…) read on XAI_API_KEY.
SPEECH_REGION=brazilsouth
SPEECH_VOICE=en-US-AvaMultilingualNeural
