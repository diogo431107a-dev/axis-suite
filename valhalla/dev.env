# Settings for local development only (pnpm dev). On a server, deploy/install.sh sets these.
#
# This file is committed, and the repository is public: never put the Claude API key here.
# It goes in data/secret.env instead (ANTHROPIC_API_KEY=...), which git ignores and the
# installer never copies. On a server the key is /etc/axis-suite/valhalla-anthropic.key.
#
# The demo users in heimdall/server/users.ts. Keep in step.
AXIS_USERS=diro,prefsbs,odin,freya,john
