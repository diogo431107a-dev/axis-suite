# Yggdrasil's Caddy site. axis-suite/deploy/install.sh fills in the @PLACEHOLDERS@ and writes it
# to /etc/caddy/sites.d/yggdrasil.caddy.
@SITE@ {
	import axis_site

	# Live updates (server-sent events). Caddy flushes text/event-stream responses as they are
	# written; flush_interval says so explicitly, so no event waits in a buffer.
	handle /api/events {
		reverse_proxy 127.0.0.1:@PORT@ {
			flush_interval -1
		}
	}

	# The API checks every request with Heimdall itself, so Caddy only forwards it.
	handle /api/* {
		reverse_proxy 127.0.0.1:@PORT@
	}

	# The built React app. Unknown paths (a zoomed bullet's /n/<id>) fall back to index.html.
	handle {
		root * @APP_DIR@/dist/web
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Vite puts a content hash in every file name under /assets, so they never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
